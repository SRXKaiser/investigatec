# Copia este archivo a .env. Cambia la contraseña y SECRET_KEY antes de usarlo.
POSTGRES_USER=investigatec
POSTGRES_PASSWORD=CAMBIAR_ANTES_DE_USAR
POSTGRES_DB=investigatec_db
DATABASE_URL=postgresql+psycopg://investigatec:CAMBIAR_ANTES_DE_USAR@db:5432/investigatec_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Genera una SECRET_KEY aleatoria con PowerShell (instrucciones en README).
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
VITE_API_URL=http://localhost:8001
API_PORT=8001
FRONTEND_PORT=5173
